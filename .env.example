# Server-side configuration for the Vercel Functions. Never commit a real .env file.
# Use mock during development. Use production only after all CRM and Turnstile values are set.
REPAIR_REQUEST_MODE=mock

# Production CRM relay settings. These values are read only by api/repair-request.mjs.
REPAIR_REQUEST_API_URL=
REPAIR_REQUEST_API_KEY=

# Cloudflare Turnstile. The site key is public; the secret key is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=techpro99.com

# Local connector. CRM_CONNECTOR_API_KEY must exactly match REPAIR_REQUEST_API_KEY.
# Keep the connector on its fixed port; change the CRM port with scripts/set-crm-port.mjs.
CRM_CONNECTOR_HOST=127.0.0.1
CRM_CONNECTOR_PORT=4399
CRM_CONNECTOR_API_KEY=

# Optional secret expected by the CRM itself when the connector forwards a request.
CRM_LOCAL_API_KEY=
